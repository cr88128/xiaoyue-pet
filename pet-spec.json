{
  "schemaVersion": 5,
  "app": {
    "name": "小悦桌宠",
    "appId": "com.xiaoyue.desktop-pet",
    "version": "1.1.0",
    "language": "zh-CN"
  },
  "targets": {
    "windows": {
      "enabled": true,
      "arch": "x64"
    },
    "macos": {
      "enabled": true,
      "arch": "current"
    }
  },
  "character": {
    "inputType": "single-image",
    "coreAsset": "core-ip/core-ip.png",
    "displayName": "小悦",
    "archetype": "person",
    "personality": [
      "温柔",
      "恭敬",
      "俏皮",
      "勤快"
    ],
    "preserveTraits": [
      "黑色齐肩短发",
      "白色荷叶边女仆头饰",
      "黑白女仆装",
      "白色围裙",
      "白色过膝长袜"
    ],
    "style": "preserve",
    "mirrorSafe": true
  },
  "assetPipeline": {
    "backgroundMode": "semantic-cutout",
    "segmentationBackend": "auto",
    "subjectKind": "photo",
    "generationBackground": "transparent-grid",
    "backgroundTolerance": 28,
    "edgeFeather": 12,
    "safeMargin": 24,
    "targetOccupancy": 0.78
  },
  "experience": {
    "theme": {
      "primary": "#2C2C2C",
      "accent": "#E8B4B8",
      "background": "#FFF5F7",
      "surface": "#FFFFFF",
      "text": "#3A2B30",
      "muted": "#A88A94",
      "cornerRadius": 22
    },
    "petSizing": {
      "baseWindowPx": 260,
      "defaultScale": 1.2
    },
    "interactions": [
      {
        "id": "pet-head",
        "emoji": "🤗",
        "label": "摸摸头",
        "stateId": "pet",
        "durationMs": 1500,
        "affectionGain": 3,
        "feedback": [
          "好舒服呀主人",
          "再摸一下嘛",
          "头发都要乱啦"
        ]
      },
      {
        "id": "kiss",
        "emoji": "💋",
        "label": "亲亲",
        "stateId": "kiss",
        "durationMs": 1500,
        "affectionGain": 4,
        "feedback": [
          "mua~",
          "主人好坏啦",
          "脸都红了"
        ]
      },
      {
        "id": "meditate",
        "emoji": "🧘",
        "label": "冥想",
        "stateId": "meditate",
        "durationMs": 2000,
        "affectionGain": 3,
        "feedback": [
          "呼...吸...",
          "心静下来了",
          "主人也试试？"
        ]
      },
      {
        "id": "bow",
        "emoji": "🙇",
        "label": "鞠躬·主人好",
        "stateId": "bow",
        "durationMs": 1800,
        "affectionGain": 2,
        "feedback": [
          "主人好",
          "今天也辛苦了",
          "请吩咐"
        ]
      },
      {
        "id": "kneel",
        "emoji": "🧎",
        "label": "迎接主人回来",
        "stateId": "kneel",
        "durationMs": 2200,
        "affectionGain": 5,
        "feedback": [
          "欢迎主人回来",
          "您回来啦",
          "小悦一直等着呢"
        ]
      }
    ]
  },
  "motion": {
    "breathing": {
      "enabled": true,
      "periodMs": 3200,
      "scaleX": 0.012,
      "scaleY": 0.022
    },
    "squashStretch": {
      "enabled": true,
      "durationMs": 320,
      "intensity": 0.08
    },
    "idleIntervalMs": {
      "min": 7000,
      "max": 13000
    }
  },
  "features": {
    "transparentWindow": true,
    "drag": true,
    "tray": true,
    "edgeSnap": true,
    "reminders": true,
    "interactions": true,
    "relationship": true,
    "filePocket": true,
    "dashboard": true,
    "typingReaction": false,
    "autonomousMovement": false
  },
